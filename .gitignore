# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# Secrets & environment
.env
.env.local
.env.*.local
!.env.example

# Data — never commit downloaded PDFs or processed chunks.
#
# These are `dir/*`, not `dir/`. Git does not descend into an excluded *directory*,
# so a `!` negation for a file inside `data/raw/` can never take effect. Excluding
# the directory's *contents* keeps the directory itself visible, which is what makes
# the negations below work at all.
data/raw/*
data/processed/*
data/interim/*

# Keep the folder structure and the tracked provenance artifacts.
!data/raw/.gitkeep
!data/raw/SOURCES.md
!data/processed/.gitkeep

# Model artifacts
*.pt
*.pth
*.safetensors
*.bin
*.onnx

# Downloaded model weights (fastembed/HuggingFace caches)
.fastembed_cache/
.cache/huggingface/

# Evaluation run outputs — regenerated, and large. The dataset itself IS committed.
data/eval/runs/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

