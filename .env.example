# MedGuard configuration.
#
#   cp .env.example .env      # then fill in the values below
#
# .env is gitignored and must never be committed. Every value here is a placeholder.
# Run `medguard doctor` after editing to verify the configuration is actually usable.

# ---------------------------------------------------------------------------
# Gemini (generation)
# ---------------------------------------------------------------------------

# Free key: https://aistudio.google.com/apikey
# The application starts without this; it reports the provider as unconfigured.
GEMINI_API_KEY=

# Generation model. Changing this requires no code change.
#
# IMPORTANT: model availability is per-API-project and changes over time. Do not
# assume a model documented as free-tier is enabled for your key -- run
# `medguard doctor`, which asks the API which models YOUR key can actually use.
GEMINI_MODEL=gemini-2.5-flash-lite

# Used when the primary model is unavailable to this API project.
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite

GEMINI_TIMEOUT_S=60
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_INITIAL_BACKOFF_S=1.0
GEMINI_RETRY_MAX_BACKOFF_S=30.0

# Low by default: grounded answers should follow the retrieved sources, not
# improvise around them.
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=2048

# ---------------------------------------------------------------------------
# Qdrant (vector store)
# ---------------------------------------------------------------------------

#   docker compose -f docker/docker-compose.yml up -d qdrant
QDRANT_URL=http://localhost:6333

# Only needed for Qdrant Cloud. Local Docker requires no key.
QDRANT_API_KEY=

# Base name only. The effective collection is suffixed with the embedding model and
# dimension (e.g. medguard__bge_small_en_v1_5__384) so that two embedding models can
# never write into the same vector space.
QDRANT_COLLECTION=medguard
QDRANT_TIMEOUT_S=30
QDRANT_PREFER_GRPC=false

# ---------------------------------------------------------------------------
# Relational store
# ---------------------------------------------------------------------------

# SQLite by default: no server, no container, no RAM cost.
DATABASE_URL=sqlite:///./medguard.db

# PostgreSQL instead (requires the `postgres` extra and the Docker profile):
#   uv sync --extra postgres
#   docker compose -f docker/docker-compose.yml --profile postgres up -d
# DATABASE_URL=postgresql+psycopg://medguard:medguard@localhost:5432/medguard

# ---------------------------------------------------------------------------
# Langfuse (observability) -- optional
# ---------------------------------------------------------------------------

# Free tier: https://cloud.langfuse.com
# Leave blank to run without tracing; the tracer becomes a no-op and the application
# is unaffected.
#
# PRIVACY: traces include your queries and retrieved document text, and they leave
# this machine. That is fine for a corpus of published guidance with no PHI. Revisit
# before pointing MedGuard at private clinical records.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Note: the v3+ SDK uses LANGFUSE_BASE_URL. LANGFUSE_HOST is accepted as a legacy alias.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Master switch: set false to disable tracing even when keys are present.
LANGFUSE_ENABLED=true

# ---------------------------------------------------------------------------
# Embeddings -- used by `medguard ingest` and, from Phase 4, by retrieval
# ---------------------------------------------------------------------------

# Runs via ONNX (fastembed), not PyTorch: chosen for a CPU-only 8 GB machine.
# On better hardware, switching to bge-base or BGE-M3 is a config change plus a
# re-index -- no code change. Changing either value changes the collection name,
# so the old index is left intact rather than silently corrupted.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_SPARSE_MODEL=Qdrant/bm25

# Texts per forward pass. 8, not the more common 32, and the arithmetic is the reason:
# peak attention allocation is roughly batch x 12 heads x 512 x 512 x 4 bytes, so 32
# spikes ~402 MB on a machine measured at 0.84 GB available and 8 spikes ~100 MB.
# Raising this trades a machine that finishes ingestion for one that is killed partway
# through, leaving a half-populated collection rather than a clean failure.
EMBEDDING_BATCH_SIZE=8

# ---------------------------------------------------------------------------
# Ingestion -- parse, chunk, embed and index. Used by `medguard ingest`.
# ---------------------------------------------------------------------------

# Sizes are in CHARACTERS, not tokens: the chunker runs before any tokeniser is loaded,
# and a character budget is checkable without one. BGE-small truncates at 512 tokens,
# roughly 2,000 characters of English prose -- hence the max below. A chunk over that
# limit is not rejected, it is silently truncated at embedding time, so half its text
# never reaches the index and nothing says so.
INGESTION_CHUNK_SIZE=1600
INGESTION_CHUNK_OVERLAP=200

# Below the minimum, a chunk is merged into a neighbour: "Table 3. Continued" embeds to
# a near-meaningless vector that still competes for a retrieval slot.
INGESTION_CHUNK_MIN_CHARS=200
INGESTION_CHUNK_MAX_CHARS=2000

# Strip repeated page headers/footers. Left in, "MMWR / Recommendations and Reports"
# appears on all 60 pages and becomes the document's highest-scoring BM25 text.
INGESTION_STRIP_RUNNING_HEADERS=true

# How many chunks `medguard ingest --dry-run` prints. Reading real chunk boundaries is
# the only reliable way to catch a chunker that works and is semantically useless.
INGESTION_DRY_RUN_SAMPLE_CHUNKS=5

# Chunks embedded and upserted per batch. Matches EMBEDDING_BATCH_SIZE for the same
# memory reason; the pipeline halves it automatically under memory pressure and
# abandons a document below 150 MB available rather than being killed mid-batch.
INGESTION_BATCH_SIZE=8

# ---------------------------------------------------------------------------
# Corpus (source documents)
# ---------------------------------------------------------------------------

# Relative paths are resolved against the project root, so the commands behave the
# same from any working directory.
CORPUS_DATA_DIR=data/raw
CORPUS_SOURCES_FILE=data/sources.yaml
CORPUS_MANIFEST_FILE=data/manifest.json

# Not cosmetic. cdc.gov returns HTTP 403 with an HTML block page to a request that
# does not look like a browser; the same URLs serve application/pdf with a full
# navigation header set. Changing this will break `medguard corpus download`.
# CORPUS_USER_AGENT=

CORPUS_DOWNLOAD_TIMEOUT_S=180

# Retries AFTER the first attempt, not total attempts. Only failures that retrying
# can plausibly fix are retried -- an HTTP 403 from a WAF is not one of them.
CORPUS_MAX_RETRIES=2
CORPUS_RETRY_INITIAL_BACKOFF_S=2.0
CORPUS_RETRY_MAX_BACKOFF_S=30.0

# Floor below which a "PDF" is assumed to be an error page or a truncated transfer.
CORPUS_MIN_PDF_BYTES=10000

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO

# `console` is human-readable; use `json` in deployment so logs are parseable.
LOG_FORMAT=console

API_HOST=127.0.0.1
API_PORT=8000
